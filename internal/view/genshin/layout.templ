package genshin

templ Layout(content templ.Component, embed DiscordEmbed, baseURL string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Genshin Impact Profile — dotcchix</title>
			<meta name="description" content="My Genshin Impact player profile, team showcases, and character builds."/>
			<meta property="og:title" content="Genshin Impact Profile — dotcchix"/>
			<meta property="og:description" content="My Genshin Impact player profile, team showcases, and character builds."/>
			<meta property="og:type" content="website"/>
			<meta name="theme-color" content="#306998"/>
			<meta name="twitter:card" content="summary_large_image"/>
			if baseURL != "" {
				<meta property="og:url" content={ baseURL + "/" }/>
				<meta property="og:image" content={ baseURL + "/static/genshin/sumeru.png" }/>
				<meta property="og:image:width" content="256"/>
				<meta property="og:image:height" content="256"/>
			}
			@templ.JSONScript("discord:component-embed", embed)
			<link rel="preload" href="/static/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="preload" href="/static/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body class="antialiased">
			@content

			<div id="gen-dialog" class="hidden"></div>

			<script>
				function genOpenDialog() {
					var d = document.getElementById("gen-dialog");
					if (d) d.classList.remove("hidden");
				}
				function genCloseDialog() {
					var d = document.getElementById("gen-dialog");
					if (d) {
						d.classList.add("hidden");
						d.innerHTML = "";
					}
				}
				function genShowLoading(el) {
					var d = document.getElementById("gen-dialog");
					if (!d) return;
					var name = (el && el.getAttribute && el.getAttribute("data-name")) || "";
					d.classList.remove("hidden");
					d.innerHTML =
						'<div class="flex flex-col items-center justify-center gap-3 px-6 py-16">' +
						'<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 animate-spin text-primary" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>' +
						'<p class="font-mono text-xs text-muted-foreground">Loading ' + name + "...</p>" +
						"</div>";
				}
				document.addEventListener("keydown", function (e) {
					if (e.key === "Escape") genCloseDialog();
				});
			</script>
		</body>
	</html>
}
