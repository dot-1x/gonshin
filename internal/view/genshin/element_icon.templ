package genshin

import (
	"strconv"

	"github.com/dotcchix/gonshin/internal/hoyolab"
)

var elementIconPath = map[hoyolab.Element]string{
	hoyolab.Pyro:    "/static/genshin/elements/Element_Pyro.webp",
	hoyolab.Hydro:   "/static/genshin/elements/Element_Hydro.webp",
	hoyolab.Electro: "/static/genshin/elements/Element_Electro.webp",
	hoyolab.Cryo:    "/static/genshin/elements/Element_Cryo.webp",
	hoyolab.Anemo:   "/static/genshin/elements/Element_Anemo.webp",
	hoyolab.Geo:     "/static/genshin/elements/Element_Geo.webp",
	hoyolab.Dendro:  "/static/genshin/elements/Element_Dendro.webp",
}

templ ElementIcon(element hoyolab.Element, class string, size int) {
	<img
		src={ elementIconPath[element] }
		alt={ string(element) }
		width={ strconv.Itoa(size) }
		height={ strconv.Itoa(size) }
		class={ class }
	/>
}
