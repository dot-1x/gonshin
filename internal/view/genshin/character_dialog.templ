package genshin

import (
	"github.com/dotcchix/gonshin/internal/hoyolab"
	"github.com/dotcchix/gonshin/internal/style"
	"github.com/dotcchix/gonshin/internal/view/ui"
)

templ CharacterDialog(detail *hoyolab.CharacterDetail) {
	@ui.DialogOverlay()
	@ui.DialogContent("max-h-[85vh] gap-0 overflow-hidden border-border/50 bg-popover p-0 sm:max-w-2xl") {
		@ui.DialogHeader("sr-only") {
			@ui.DialogTitle("") {
				{ detail.Name }
			}
			@ui.DialogDescription("") {
				Detailed stats, weapon and constellations for { detail.Name }
			}
		}

		@ui.ScrollArea("max-h-[85vh]") {
			<div class="space-y-5 p-6">
				<div class="flex gap-4">
					<div class="relative h-24 w-24 shrink-0 overflow-hidden rounded-xl border border-border/50 bg-muted">
						<img
							src={ detail.Icon }
							alt={ detail.Name }
							class="absolute inset-0 h-full w-full object-cover"
							sizes="96px"
						/>
						@elementDot(&detail.Element, "absolute left-1.5 top-1.5 h-3 w-3 rounded-full ring-2 ring-background")
					</div>
					<div class="min-w-0 flex-1">
						<div class="flex flex-wrap items-center gap-2">
							<h2 class="text-lg font-semibold leading-none text-foreground">{ detail.Name }</h2>
							if detail.Element != "" {
								<span
									class="inline-flex items-center gap-1 rounded-full border border-border/50 bg-muted/40 px-2 py-0.5 text-xs"
									style={ "color: " + colorOf(&detail.Element) }
								>
									@ElementIcon(detail.Element, "", 14)
									{ string(detail.Element) }
								</span>
							}
						</div>

						<div class="mt-2 flex flex-wrap items-center gap-2">
							@ui.Badge("secondary", "font-mono text-xs", nil) {
								{ lv(detail.Level) }
							}
							@ui.Badge("outline", "border-primary/40 text-primary font-mono text-xs", nil) {
								{ cLabel(detail.ActivedConstellationNum) }
							}
							if detail.Rarity > 0 {
								<span class="inline-flex items-center gap-0.5 text-amber-400">
									for i := 0; i < detail.Rarity; i++ {
										@ui.IconStar("h-3.5 w-3.5 fill-amber-400 text-amber-400")
									}
								</span>
							}
						</div>

						if detail.Weapon != nil {
							@weaponLine(detail.Weapon)
						}
					</div>
				</div>

				if len(detail.FinalStats) > 0 {
					<div class="space-y-2">
						<h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-muted-foreground">Stats</h3>
						<div class="rounded-lg border border-border/50 bg-card px-4 py-3">
							@statGrid(detail.FinalStats)
							{{ label, value, ok := elementBonus(detail.FinalStats) }}
							if ok {
								<div class="mt-2 flex items-center justify-between border-t border-border/40 pt-2 text-xs">
									<span class="text-muted-foreground">{ label }</span>
									<span class="font-mono font-medium text-foreground">{ value }</span>
								</div>
							}
						</div>
					</div>
				}

				if len(detail.ArtifactSets) > 0 {
					<div class="space-y-2">
						<h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-muted-foreground">Artifact Sets</h3>
						<div class="flex flex-wrap gap-1.5">
							for _, set := range detail.ArtifactSets {
								@ui.Badge("secondary", "rounded-md border border-secondary/20 bg-secondary px-2.5 py-1 text-xs font-normal text-secondary-foreground", nil) {
									{ set }
								}
							}
						</div>
					</div>
				}

				if len(detail.Constellations) > 0 {
					<div class="space-y-2">
						<h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-muted-foreground">Constellations</h3>
						<div class="grid gap-2">
							for _, c := range sortedConstellations(detail.Constellations) {
								<div class={
									style.CN(
										"flex gap-3 rounded-lg border px-3 py-3 transition-colors",
										activeClass(c.IsActived, "border-primary/40 bg-primary/10", "border-border/40 bg-muted/20 opacity-80"),
									)
								}>
									<div class="relative h-12 w-12 shrink-0 overflow-hidden rounded-md border border-border/30 bg-background">
										<img src={ c.Icon } alt={ c.Name } class="absolute inset-0 h-full w-full object-cover" sizes="48px" />
										<span class={
											style.CN(
												"absolute bottom-0 right-0 rounded-tl-md px-1 py-0.5 font-mono text-[0.6rem] leading-none",
												activeClass(c.IsActived, "bg-primary text-primary-foreground", "bg-muted text-muted-foreground"),
											)
										}>
											{ cLabel(c.Pos) }
										</span>
									</div>
									<div class="min-w-0 flex-1">
										<div class="flex items-center gap-2">
											<p class="truncate text-sm font-medium text-foreground">{ c.Name }</p>
											if c.IsActived {
												<span class="inline-flex h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
											}
										</div>
										<p class="mt-1 line-clamp-3 text-xs leading-relaxed text-muted-foreground">{ stripColorTags(c.Effect) }</p>
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>
		}
	}
}

templ CharacterDialogError(message string) {
	@ui.DialogOverlay()
	@ui.DialogContent("max-h-[85vh] gap-0 overflow-hidden border-border/50 bg-popover p-0 sm:max-w-2xl") {
		<div class="px-6 py-10 text-center">
			<p class="text-sm font-medium text-destructive">{ message }</p>
		</div>
	}
}

templ CharacterDialogLoading(name string) {
	<div class="flex flex-col items-center justify-center gap-3 px-6 py-16">
		@ui.IconLoader("h-6 w-6 animate-spin text-primary")
		<p class="font-mono text-xs text-muted-foreground">Loading { name }...</p>
	</div>
}

templ weaponLine(weapon *hoyolab.Weapon) {
	<div class="mt-3 flex items-center gap-2 rounded-lg border border-border/40 bg-muted/30 px-3 py-2">
		<img src={ weapon.Icon } alt={ weapon.Name } width="32" height="32" class="h-8 w-8 shrink-0 object-contain" />
		<div class="min-w-0">
			<p class="truncate text-sm font-medium text-foreground">{ weapon.Name }</p>
			<p class="text-xs text-muted-foreground">{ lv(weapon.Level) }{ refineSuffix(weapon.Refine) }</p>
		</div>
	</div>
}

templ statGrid(stats []hoyolab.FinalStat) {
	{{ left, right := splitStats(stats) }}
	<div class="grid grid-cols-2 gap-3">
		for _, col := range [][]hoyolab.FinalStat{left, right} {
			<div class="flex flex-col gap-1">
				for _, s := range col {
					<span class="flex items-baseline justify-between gap-2 text-xs leading-tight">
						<span class="text-muted-foreground">{ normName(s.Name) }</span>
						<span class="font-mono font-medium text-foreground">{ s.Value }</span>
					</span>
				}
			</div>
		}
	</div>
}

func sortedConstellations(cs []hoyolab.Constellation) []hoyolab.Constellation {
	out := make([]hoyolab.Constellation, len(cs))
	copy(out, cs)
	for i := 1; i < len(out); i++ {
		for j := i; j > 0 && out[j-1].Pos > out[j].Pos; j-- {
			out[j-1], out[j] = out[j], out[j-1]
		}
	}
	return out
}
