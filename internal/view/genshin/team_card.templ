package genshin

import (
	"github.com/dotcchix/gonshin/internal/hoyolab"
	"github.com/dotcchix/gonshin/internal/view/ui"
)

templ TeamCard(team hoyolab.DisplayTeam, defaultOpen bool) {
	@ui.Card("gap-0 overflow-hidden border-border/50 bg-card backdrop-blur-sm", nil) {
		<details open?={ defaultOpen } class="group">
			<summary class="flex cursor-pointer list-none flex-col gap-2 px-5 py-3.5 transition-colors hover:bg-accent/30 [&::-webkit-details-marker]:hidden">
				<div class="flex items-center justify-between gap-3">
					<h3 class="line-clamp-1 text-sm font-semibold text-primary">
						if team.Name != "" {
							{ team.Name }
						} else {
							Team
						}
					</h3>
					<div class="flex items-center gap-3 text-xs text-muted-foreground">
						if team.ClearTime != nil {
							<span class="flex items-center gap-1 font-mono">
								@ui.IconClock("h-3 w-3")
								{ FormatClearTime(team.ClearTime) }
							</span>
						}
						@ui.IconChevronDown("h-4 w-4 transition-transform duration-200 group-open:rotate-180")
					</div>
				</div>
				<div class="flex -space-x-2">
					for i, char := range team.Characters {
						<span
							class="relative h-7 w-7 overflow-hidden rounded-full border border-border bg-background ring-2 ring-background"
							style={ "z-index: " + zIndexValue(len(team.Characters), i) }
							title={ char.Name }
						>
							<img src={ char.Icon } alt={ char.Name } class="absolute inset-0 h-full w-full object-cover" sizes="28px" />
						</span>
					}
				</div>
			</summary>

			@ui.Separator("horizontal", "bg-border/50")

			<div class="divide-y divide-border/30">
				for _, char := range team.Characters {
					@CharacterRow(char)
				}
			</div>
		</details>
	}
}
